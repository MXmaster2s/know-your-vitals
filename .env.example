# Copy to .env.local and fill in. Both are safe to expose in the browser
# bundle — row-level security is what protects the data, not these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — product analytics. Leave blank to disable entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional — a "request access" link in the footer. Leave blank to hide it.
NEXT_PUBLIC_CHECKOUT_URL=
